{
  "name": "bad-smells-js-refactoring",
  "version": "1.0.0",
  "description": "Projeto de exemplo para o trabalho de refatoração e bad smells.",
  "main": "src/ReportGenerator.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:original": "npm test -- --runInBand --runTestsByPath tests/ReportGenerator.test.js",
    "test:refactored": "npm test -- --runInBand --runTestsByPath __tests__/ReportGenerator.refactored.test.js",
    "lint": "eslint src/",
    "lint:refactored": "eslint src/ReportGenerator.refactored.js",
    "audit:behavior": "node scripts/audit-behavior.mjs",
    "audit:quality": "node scripts/audit-quality.mjs"
  },
  "keywords": [
    "refactoring",
    "bad-smells",
    "jest",
    "eslint"
  ],
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.23.2",
    "eslint": "8.57.1",
    "eslint-plugin-sonarjs": "0.21.0",
    "jest": "29.7.0"
  },
  "jest": {
    "transform": {}
  }
}
